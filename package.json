{
    "name": "crm-student-admin",
    "version": "1.0.0",
    "description": "High-performance CRM Admin Panel for managing 10-20 Lakh student records",
    "private": true,
    "workspaces": [
        "frontend",
        "backend"
    ],
    "scripts": {
        "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
        "dev:frontend": "npm run dev --workspace=frontend",
        "dev:backend": "npm run dev --workspace=backend",
        "build": "npm run build --workspaces",
        "start": "npm run start --workspaces",
        "db:push": "npm run db:push --workspace=backend",
        "db:migrate": "npm run db:migrate --workspace=backend",
        "db:seed": "npm run db:seed --workspace=backend"
    },
    "keywords": [
        "crm",
        "admin-panel",
        "student-management",
        "lead-management"
    ],
    "author": "Het Patel",
    "license": "MIT",
    "devDependencies": {
        "concurrently": "^8.2.2"
    }
}